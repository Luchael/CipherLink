# Never commit user-specific credentials, settings or runtime data
.env
.env.*
**/config.json
**/data/
**/*.db
**/*.db-shm
**/*.db-wal
**/*.log
**/__pycache__/
**/*.pyc
**/.venv/
**/.gradle/
**/.kotlin/
**/.idea/
**/local.properties
**/build/
**/dist/
**/*.apk
**/*.aab
**/*.jks
**/*.keystore
**/*api_diagnostic*.json

# Android private signing material and local setup bundles
**/*.p12
**/*.pfx
**/github-secret-*.txt
**/CipherLink-signing-key-backup-*.zip
**/CipherLink-GitHub-signing-setup-*.zip
